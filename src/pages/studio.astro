---
import Layout from '../layouts/Layout.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';

const productPoints = [
  'A GUI for prompting, previewing results, reviewing changes, and iterating on creative tasks.',
  'A front end for the open-source HarnessGG stack, not a separate hidden system.',
  'A way to watch agent work happen in real desktop software instead of only reading terminal output.',
];

const audience = [
  'People who want a visual review loop while working with AI agents.',
  'Creative workflows that need previews, inspection, and fast iteration.',
  'Teams that want the Harness stack in a more accessible product surface.',
];
---

<Layout
  title="Harness Studio | Harness.gg"
  description="Harness Studio is a visual interface for AI-powered creative tasks, built on the same open-source Harness packages that drive real desktop software."
>
  <section class="pt-10 pb-10 wrap">
    <p class="breadcrumb">
      <a href="/">harness.gg</a>
      <span>/</span>
      studio
    </p>

    <div class="title-row">
      <h1>Studio</h1>
      <Badge className="badge-live">New</Badge>
      <Badge variant="outline" className="badge-ver">Visual interface</Badge>
    </div>

    <p class="subhead">by HarnessGG</p>

    <p class="tagline">
      A visual interface for AI-powered creative tasks. Studio gives the Harness stack a product surface for prompting,
      previewing results, reviewing changes, and iterating with an agent while the actual work runs in real desktop software.
    </p>

    <div class="install-row">
      <code>Built on the open-source HarnessGG stack</code>
    </div>

    <div class="ext-links">
      <a href="https://github.com/harnessgg" target="_blank" rel="noopener">
        <Badge variant="outline" className="ext-badge">GitHub &nearr;</Badge>
      </a>
      <a href="/">
        <Badge variant="outline" className="ext-badge">Homepage &nearr;</Badge>
      </a>
      <a href="/kdenlive">
        <Badge variant="outline" className="ext-badge">Kdenlive docs &nearr;</Badge>
      </a>
    </div>
  </section>

  <Separator />

  <section class="wrap sec">
    <h2>What it is</h2>
    <p class="sec-intro">
      Studio is the product layer for HarnessGG. Instead of asking people to understand a CLI-first workflow from raw
      terminal output, Studio gives that same system a visual interface. The goal is simple: make agent-driven creative
      work visible, inspectable, and easier to steer.
    </p>

    <div class="card-list">
      {productPoints.map((point) => (
        <article class="info-card">
          <p>{point}</p>
        </article>
      ))}
    </div>
  </section>

  <Separator />

  <section class="wrap sec">
    <h2>Why it exists</h2>
    <p class="sec-intro">
      HarnessGG already gives agents structured tools for real apps. Studio exists because many users want to see the
      process as it happens, review outputs in context, and iterate without living entirely inside terminal logs.
    </p>
    <div class="feature-grid">
      <article class="feature-card">
        <h3>Prompting</h3>
        <p>Describe the task in a product UI instead of stitching together commands by hand.</p>
      </article>
      <article class="feature-card">
        <h3>Preview</h3>
        <p>See what the agent is producing in a visual workspace instead of inferring it from JSON and stdout.</p>
      </article>
      <article class="feature-card">
        <h3>Review</h3>
        <p>Inspect changes, compare results, and decide what should happen next with the output in front of you.</p>
      </article>
      <article class="feature-card">
        <h3>Iteration</h3>
        <p>Ask for revisions and keep working in the same flow, rather than restarting the process from scratch.</p>
      </article>
    </div>
  </section>

  <Separator />

  <section class="wrap sec">
    <h2>Who it is for</h2>
    <div class="card-list">
      {audience.map((item) => (
        <article class="info-card">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <Separator />

  <section class="wrap sec">
    <h2>Built on HarnessGG</h2>
    <p class="sec-intro">
      Studio runs on the same open-source Harness packages shown on the homepage. The visual layer is new, but the
      automation layer stays grounded in the existing Harness ecosystem and real desktop software.
    </p>
    <p class="note">
      Start at <a href="/">the homepage</a> for package discovery, or go to <a href="/kdenlive">/kdenlive</a> and
      <a href="/blender"> /blender</a> if you want to inspect the underlying tools.
    </p>
  </section>
</Layout>

<style>
  h1, h2 { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  h2, h3 { font-family: 'Source Serif 4', Georgia, serif; }
  code, p { font-family: inherit; }

  .wrap { max-width: 840px; margin: 0 auto; padding: 0 24px; }
  .sec  { padding: 40px 0; }

  .breadcrumb { font-size: 0.82rem; color: var(--muted-foreground); margin-bottom: 16px; }
  .breadcrumb a { color: var(--muted-foreground); text-decoration: none; }
  .breadcrumb a:hover { color: var(--primary); }
  .breadcrumb span { margin: 0 6px; opacity: 0.4; }

  .title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  h1 { font-size: clamp(1.2rem, 3.5vw, 1.7rem); font-weight: 500; color: var(--foreground); }
  .badge-live { background: color-mix(in oklch, var(--primary) 12%, transparent); color: var(--primary); border: none; font-size: 0.7rem; }
  .badge-ver  { font-family: 'IBM Plex Mono', monospace; font-size: 0.7rem; color: var(--muted-foreground); }

  .subhead {
    font-size: 0.78rem;
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 12px;
  }

  .tagline { font-size: 1rem; color: var(--muted-foreground); max-width: 680px; line-height: 1.75; margin-bottom: 20px; }

  .install-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 12px 16px;
    background: var(--secondary); border: 2px solid #5a7a8a; border-radius: 10px;
    max-width: 440px; margin-bottom: 16px;
  }
  .install-row code { font-size: 0.88rem; color: var(--foreground); }

  .ext-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .ext-badge { font-size: 0.78rem; cursor: pointer; transition: all 0.15s; }
  .ext-badge:hover { border-color: var(--primary); color: var(--primary); }

  h2 { font-size: 1.25rem; font-weight: 600; color: var(--foreground); margin-bottom: 16px; }
  h3 { font-size: 1.05rem; color: var(--foreground); margin-bottom: 10px; }
  .sec-intro { font-size: 0.92rem; color: var(--muted-foreground); margin-bottom: 20px; line-height: 1.75; }
  .note { font-size: 0.82rem; color: var(--muted-foreground); margin-top: 12px; line-height: 1.7; }
  .note a, .sec-intro a { color: var(--primary); }

  .card-list,
  .feature-grid {
    display: grid;
    gap: 16px;
  }

  .info-card,
  .feature-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
  }

  .info-card p,
  .feature-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 600px) {
    h1 { font-size: 1.2rem; }
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>
